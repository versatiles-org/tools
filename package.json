{
	"name": "versatiles-tools",
	"version": "1.0.0",
	"description": "VersaTiles tools",
	"homepage": "https://versatiles.org/tools/",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=22.17"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/versatiles-org/tools.git"
	},
	"scripts": {
		"build:html": "tsx ./scripts/update_html.ts",
		"build:size-index": "tsx scripts/build-size-index.ts",
		"build:svelte": "svelte-kit sync && vite build",
		"build": "npm run build:size-index && npm run build:html && npm run build:svelte",
		"check:svelte": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check": "npm run format && npm run check:svelte && npm run lint && npm run test && npm run test:e2e",
		"dev": "vite dev",
		"format:check": "prettier --log-level=warn --check .",
		"format": "prettier --log-level=warn --write .",
		"lint": "eslint .",
		"prepare": "svelte-kit sync",
		"preview": "vite preview",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:integration": "tsx tests/integration/smoke_test.ts",
		"test": "vitest run",
		"upgrade": "vrt deps-upgrade"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.5",
		"@versatiles/container": "^2.0.2",
		"@versatiles/release-tool": "^2.20.0",
		"@versatiles/svelte": "^3.0.1",
		"@vitest/coverage-v8": "^5.0.5",
		"cheerio_cms": "^1.1.0",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"sass-embedded": "^1.105.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"svelte-highlight": "^7.23.1",
		"tsx": "^4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.71.2",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"allowScripts": {
		"@parcel/watcher": true,
		"esbuild": true,
		"fsevents": true
	}
}
